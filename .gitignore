*.log
npm-debug.log*

# prisma
server/prisma/*.db

# uploads (runtime) — EXCEPT the menu's seed photos (see server/src/bootstrap/menu.ts), which
# are committed on purpose: they need to exist right after a fresh `git clone` on any host,
# including ones with an ephemeral filesystem (Render's free plan) where nothing uploaded at
# runtime survives a redeploy. Any *other* file dropped into this folder — a real
# admin-uploaded photo — stays ignored, same as before.
server/src/uploads/*
!server/src/uploads/.gitkeep
