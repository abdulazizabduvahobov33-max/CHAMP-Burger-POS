# ── Used only by docker-compose.yml (Postgres container + inter-container DB URL) ──
# Copy to `.env` in this same folder before running `docker compose up`.
# Backend app config (JWT secrets, CORS origin, etc.) lives in server/.env — copy
# server/.env.example there too. Both files are read; this one only feeds Postgres + the
# DATABASE_URL the backend container connects with.

POSTGRES_USER=champ
# Production: a real random password — e.g. `openssl rand -base64 24` — not this placeholder.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=champ_pos

# Host port the frontend's nginx is published on. Behind a host-level reverse proxy (see
# deploy/nginx-host.conf) this stays 8080 and only nginx faces the internet on 80/443.
# Exposing 80 directly here too is fine for a quick local `docker compose up` test.
FRONTEND_PORT=8080
