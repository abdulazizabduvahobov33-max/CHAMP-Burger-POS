# Base URL of the backend API.
# In dev, Vite proxies /api to the server, so a relative value works.
# Docker/VPS (nginx in front of both, see deploy/nginx-host.conf or the frontend container's
# nginx.conf): keep this relative too — nginx proxies /api and /uploads to the backend on the
# SAME domain, so the browser never needs a separate API origin (and CORS stays simple: one
# origin, credentials: true).
# Render (or any split-host deploy — a static site + a separate backend service, no shared
# nginx in front): there IS no same domain, so this MUST be the backend's full URL instead,
# e.g. VITE_API_URL="https://champ-pos-backend.onrender.com/api" — set as a build-time env var
# on the static site (see render.yaml / docs/RENDER_DEPLOY.md). CORS (CLIENT_URL on the
# backend) and the refresh-token cookie's SameSite=None already support this cross-origin case.
VITE_API_URL="/api"
