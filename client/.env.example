# Base URL of the backend API.
# In dev, Vite proxies /api to the server, so a relative value works.
# Production: keep this relative too — nginx (see deploy/nginx-host.conf, or the frontend
# container's nginx.conf in Docker) proxies /api and /uploads to the backend on the SAME
# domain, so the browser never needs a separate API origin (and CORS stays simple: one
# origin, credentials: true). Only change this if the API is deliberately served from a
# different domain than the frontend.
VITE_API_URL="/api"
