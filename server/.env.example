# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Production: use the real DB host/credentials (in Docker Compose this is the `postgres`
# service name, not `localhost` — see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champ_pos?schema=public"

# ── Server ──────────────────────────────────────────────────
PORT=4000
# development | production — gates: cookie Secure flag, access-log format (dev/combined),
# stack traces in error responses, and Prisma query logging.
NODE_ENV=development

# CORS: comma-separated list of allowed client origins (scheme + host, no trailing slash).
# Production example: CLIENT_URL="https://champpos.uz,https://www.champpos.uz"
CLIENT_URL="http://localhost:5173"

# Set to true ONLY when a real reverse proxy (nginx, Cloudflare, a load balancer) sits in
# front of this process and is itself trusted to set X-Forwarded-For correctly. Enabling
# this without a proxy in front lets any client spoof that header to dodge rate limiting.
TRUST_PROXY=false

# ── Auth ─────────────────────────────────────────────────────
# Production: generate real random secrets, e.g. `openssl rand -base64 48` — never reuse
# the placeholders below, they are public (checked into this example file).
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ── Seed super admin credentials ────────────────────────────
# Used once, by `npm run seed`, to create the first SUPER_ADMIN row. Production: set a real
# password here BEFORE the first seed run, then change it from Settings → Users after login
# (the seed is not re-run automatically, so editing this file later has no effect).
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Super Admin"

# ── Seed demo seller credentials ────────────────────────────
# Optional — creates one demo SELLER row. Skip in production by removing/leaving these as-is
# and deleting the account afterwards from Users, or by not caring (SELLER has no admin
# access) if you want a ready-made cashier login on day one.
SEED_SELLER_LOGIN="seller"
SEED_SELLER_PASSWORD="seller123"
SEED_SELLER_NAME="Продавец"
