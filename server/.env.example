# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Production: use the real DB host/credentials (in Docker Compose this is the `postgres`
# service name, not `localhost` — see docker-compose.yml).
# Render: use the "Internal Database URL" from the Render Postgres dashboard — render.yaml
# already wires this automatically via `fromDatabase`, so you normally don't set this by hand.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champ_pos?schema=public"

# ── Server ──────────────────────────────────────────────────
# Render sets this automatically for web services — no need to set it yourself there.
PORT=4000
# development | production — gates: cookie Secure flag, cookie SameSite (see
# auth.controller.ts — "none" in production, needed for a split-host deploy like Render),
# access-log format (dev/combined), stack traces in error responses, Prisma query logging.
NODE_ENV=development

# CORS: comma-separated list of allowed client origins (scheme + host, no trailing slash).
# Production example: CLIENT_URL="https://champpos.uz,https://www.champpos.uz"
# Render: the frontend static site's URL, e.g. "https://champ-pos-frontend.onrender.com"
CLIENT_URL="http://localhost:5173"

# Set to true ONLY when a real reverse proxy (nginx, Cloudflare, a load balancer, or a
# platform load balancer like Render's) sits in front of this process and is itself trusted
# to set X-Forwarded-For correctly. Enabling this without a proxy in front lets any client
# spoof that header to dodge rate limiting. Render: set to true (render.yaml already does).
TRUST_PROXY=false

# ── Auth ─────────────────────────────────────────────────────
# Production: generate real random secrets, e.g. `openssl rand -base64 48` — never reuse
# the placeholders below, they are public (checked into this example file).
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ── Seed super admin credentials ────────────────────────────
# Used once, by `npm run seed`, to create the first SUPER_ADMIN row. Production: set a real
# password here BEFORE the first seed run, then change it from Settings → Users after login
# (the seed is not re-run automatically, so editing this file later has no effect).
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Super Admin"

# ── Seed demo seller credentials ────────────────────────────
# Optional — creates one demo SELLER row. Skip in production by removing/leaving these as-is
# and deleting the account afterwards from Users, or by not caring (SELLER has no admin
# access) if you want a ready-made cashier login on day one.
SEED_SELLER_LOGIN="seller"
SEED_SELLER_PASSWORD="seller123"
SEED_SELLER_NAME="Продавец"

# ── Owner account (/owner panel) ─────────────────────────────
# Deliberately NOT set here by default, unlike SEED_ADMIN_*/SEED_SELLER_* above — the owner
# panel exists to be reachable by nobody who can read this codebase or the admin-managed Users
# list. In production, set BOTH of these directly in the hosting platform's environment config
# (Render dashboard → Environment, never committed to git) to whatever login/password only the
# restaurant owner knows, then redeploy — the account is created once on the next boot and never
# overwritten again, even if you change these values later (rotate the password from inside the
# owner panel itself instead, once logged in).
# OWNER_LOGIN="owner"
# OWNER_PASSWORD="a-real-password-only-the-owner-knows"

# ── Product photo storage (Supabase Storage) ──────────────────
# Optional. Render's free plan has no persistent disk — anything written to the local
# /uploads folder at runtime is lost on the next deploy/restart (the 18 original menu photos
# survive because they're committed to git, not because they're "stored"; see
# server/prisma/checkMissingProductImagesRemote.ts, which is what proved this). Setting all
# three of these switches new uploads (product photos, company logo) to Supabase Storage's free
# tier instead — the local /uploads folder and the 18 git photos keep working exactly as before
# either way; this only changes where a NEW upload goes. Talks to Supabase's plain REST API
# directly (no @supabase/supabase-js dependency needed for just upload/delete/public-URL).
#
# Setup: supabase.com → sign up (free) → New project → Storage (left sidebar) → New bucket →
# name it exactly "champ-pos-uploads" → toggle it **Public** (read access) when creating it, or
# afterwards via bucket → Settings. Then Project Settings → API → copy the "Project URL" (→
# SUPABASE_URL below) and the **service_role** secret key (→ SUPABASE_SERVICE_ROLE_KEY — NOT the
# "anon public" key; service_role is what lets the server upload/delete without configuring
# Storage RLS policies, and it must never be exposed to the client/browser).
#
# Set the real values in the Render dashboard under champ-pos-backend → Environment (never
# commit real credentials to git), and here in your local server/.env only if you want to test
# the Supabase path locally too — leave all three unset/blank to keep using local disk storage
# as before.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET_NAME="champ-pos-uploads"
