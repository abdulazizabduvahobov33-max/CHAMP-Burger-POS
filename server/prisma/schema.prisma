// ─────────────────────────────────────────────────────────────
// Sharof KFS — POS + Inventory
// Prisma schema (Module 1)
//
// Covers the full approved architecture:
//   • MVP tables (implemented across later modules)
//   • Future-ready tables (PriceHistory, Setting, Backup) — defined now,
//     used later, so no schema rewrite is ever needed
//   • Multi-location fields present everywhere (single default location
//     is used for now; enabling more branches requires NO migration)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

// OWNER is deliberately separate from SUPER_ADMIN — the restaurant owner's own login, never
// something a SUPER_ADMIN account can promote itself to via the app (user.schema.ts's role
// enum for admin-managed users excludes it). It exists purely to gate the owner panel (final
// corrections to already-ACCEPTED sales, and the only role that can decline a pending order —
// see sale.routes.ts) behind credentials nobody else controls.
enum Role {
  SUPER_ADMIN
  SELLER
  OWNER
}

enum Unit {
  PIECE // шт
  KG // кг
  G // г
  L // л
  ML // мл
}

// UNIT   — обычный товар, списывается по рецепту поштучно
// WEIGHT — продаётся по весу (Kefsi), продавец вводит вес
// DIRECT — товар = складская позиция (напитки), рецепта нет  [реализуем позже]
enum SaleType {
  UNIT
  WEIGHT
  DIRECT
}

// PENDING — a waiter/seller sent the order but stock hasn't been deducted and payment hasn't
// been captured yet; ACCEPTED — an admin confirmed it (or it was rung up directly at the
// register, which creates it already-accepted) — see sale.service.ts's createSale/acceptSale.
// REJECTED — declined while still PENDING (before any payment/stock effect), owner-only (see
// sale.routes.ts). CANCELLED — an already-ACCEPTED (paid, stock-deducted) sale the owner later
// voided through the owner panel — a distinct terminal state from REJECTED specifically because
// it has real effects to reverse (see owner.service.ts's cancelSale), not just a status flip.
enum SaleStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// One entry per correction the owner panel makes to an already-ACCEPTED sale — the permanent,
// human-readable "what happened" record the owner relies on instead of the app ever performing a
// real DELETE. See owner.service.ts; SaleChangeLog rows are never updated or deleted by anything.
enum SaleChangeType {
  ITEM_REMOVED
  ITEM_ADDED
  QUANTITY_CHANGED
  PRICE_CHANGED
  SALE_CANCELLED
}

enum StockReason {
  PURCHASE // приход по закупке
  SALE // списание при продаже
  ADJUST // ручная корректировка
  WASTE // брак / списание
}

// ── Core / reference ─────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users          User[]
  stock          Stock[]
  purchases      Purchase[]
  sales          Sale[]
  stockMovements StockMovement[]
  aiMessages     AiMessage[]
  tables         Table[]

  @@map("locations")
}

model User {
  id           String   @id @default(cuid())
  name         String
  // Case-sensitive uniqueness via @unique below; a SECOND, case-insensitive unique index
  // also exists in the DB (migration 20260708110500_user_login_ci_unique, not representable
  // here) so "admin2" and "Admin2" can't both exist — login is checked case-insensitively in
  // user.service.ts's assertLoginAvailable.
  login        String   @unique
  passwordHash String
  role         Role     @default(SELLER)
  isActive     Boolean  @default(true)
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())

  sales          Sale[]
  purchases      Purchase[]      @relation("PurchaseCreatedBy")
  stockMovements StockMovement[] @relation("MovementCreatedBy")
  priceChanges   PriceHistory[]  @relation("PriceChangedBy")
  backups        Backup[]        @relation("BackupCreatedBy")
  refreshTokens  RefreshToken[]
  aiMessages     AiMessage[]     @relation("AiMessageOwner")
  cancelledSales Sale[]          @relation("SaleCancelledBy")
  removedSaleItems SaleItem[]    @relation("SaleItemRemovedBy")
  saleChangeLogs SaleChangeLog[] @relation("SaleChangePerformedBy")

  @@index([login])
  @@map("users")
}

// Server-side record of issued refresh tokens — enables logout / revocation
// and rotation-on-refresh (each refresh revokes the old token, issues a new one).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  purchases Purchase[]

  @@map("suppliers")
}

model Ingredient {
  id           String   @id @default(cuid())
  // Case-insensitive uniqueness among ACTIVE ingredients is enforced by a partial functional
  // index (migration 20260708110000_ingredient_name_ci_unique) — Prisma's DSL can't express
  // `UNIQUE (lower(name)) WHERE "isActive"`, so there's no @unique here even though one exists
  // in the DB. Same pattern as Category.name.
  name         String
  unit         Unit
  minQuantity  Decimal  @default(0) @db.Decimal(12, 3) // порог алерта "мало на складе"
  lastUnitCost Decimal  @default(0) @db.Decimal(12, 2) // последняя закупочная цена / ед.
  avgUnitCost  Decimal  @default(0) @db.Decimal(12, 2) // средневзвешенная себестоимость / ед.
  isActive     Boolean  @default(true) // мягкое удаление — сохраняет историю движений
  createdAt    DateTime @default(now())

  stock          Stock[]
  recipes        Recipe[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@map("ingredients")
}

// Остаток ингредиента ПО ФИЛИАЛУ (мультифилиальность заложена сразу).
model Stock {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])
  quantity     Decimal    @default(0) @db.Decimal(12, 3)
  updatedAt    DateTime   @updatedAt

  @@unique([ingredientId, locationId])
  @@index([ingredientId])
  @@map("stock")
}

// ── Products / menu ──────────────────────────────────────────

// A physical table in the dining room. Deliberately minimal — number + active flag — so the
// "12 tables today, more later" requirement is satisfied by admins just adding rows, never a
// code change. Not tied to any notion of an open/closed session yet (a table doesn't "belong" to
// an order); that's intentionally left for later — a future TableSession-style layer can be added
// as a purely additive migration on top of this without touching what's here.
model Table {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  number     Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  sales Sale[]

  @@unique([locationId, number])
  @@index([locationId])
  @@map("tables")
}

model Category {
  id        String   @id @default(cuid())
  // Case-insensitive uniqueness is enforced by a functional index
  // (migration 20260707185104_category_name_ci_unique) — Prisma's DSL can't express
  // `UNIQUE (lower(name))`, so there's no @unique here even though one exists in the DB.
  name      String
  // Menu-position rank (10, 20, 30…) so the POS category pills read in a deliberate order
  // instead of alphabetically — null for anything created before this column existed or by an
  // admin since, which sorts after every ranked category (Postgres puts NULLs last in ASC).
  sortOrder Int?
  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  imageUrl   String?
  saleType   SaleType @default(UNIT)
  // Same menu-position ranking as Category.sortOrder, same null-sorts-last fallback for
  // anything not explicitly ranked (a fresh admin-created product, for instance).
  sortOrder  Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  variants ProductVariant[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // напр. "25 000", "35 000", "за кг"
  price     Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  recipe       Recipe[]
  saleItems    SaleItem[]
  priceHistory PriceHistory[]

  @@index([productId])
  @@map("product_variants")
}

// BOM: состав одного варианта товара.
model Recipe {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])
  quantity     Decimal        @db.Decimal(12, 3) // сколько ингредиента на 1 продажу варианта

  @@unique([variantId, ingredientId])
  @@index([variantId])
  @@map("recipes")
}

// ── Purchasing ───────────────────────────────────────────────

model Purchase {
  id           String    @id @default(cuid())
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  purchaseDate DateTime  @default(now())
  totalCost    Decimal   @default(0) @db.Decimal(14, 2)
  note         String?
  createdById  String
  createdBy    User      @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  items PurchaseItem[]

  @@index([purchaseDate])
  // Module 8: purchase list/report queries scope by location first, then filter/range on
  // purchaseDate — same access pattern as Sale(locationId, createdAt) in Module 7.
  @@index([locationId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id           String     @id @default(cuid())
  purchaseId   String
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  packQuantity Decimal    @db.Decimal(12, 3) // кол-во упаковок (10)
  unitsPerPack Decimal    @db.Decimal(12, 3) // штук в упаковке (10)
  packPrice    Decimal    @db.Decimal(12, 2) // цена упаковки (70 000)
  // totalUnits = packQuantity * unitsPerPack  (100)
  // unitCost   = packPrice / unitsPerPack     (7 000)

  @@index([purchaseId])
  @@index([ingredientId])
  @@map("purchase_items")
}

// ── Sales / POS ──────────────────────────────────────────────

model Sale {
  id           String     @id @default(cuid())
  sellerId     String
  seller       User       @relation(fields: [sellerId], references: [id])
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])
  // Which dining table this order was for — null for admin/register sales that aren't tied to a
  // seated table (takeaway, or the admin ringing something up directly). Required at the
  // application layer (not the DB) specifically for seller-created orders — see
  // sale.service.ts's createSale.
  tableId      String?
  table        Table?     @relation(fields: [tableId], references: [id])
  totalAmount  Decimal    @default(0) @db.Decimal(14, 2)
  // Cash tendered by the customer and change handed back — both nullable: only cash checkouts
  // (the only payment method the POS supports today) populate them; a future non-cash payment
  // method leaves both null rather than storing a meaningless 0. Captured for the receipt, which
  // conventionally shows "Получено" / "Сдача" lines (see the Sale.cashReceived/changeGiven read
  // path in report/receipt code once printing is wired up).
  cashReceived Decimal?   @db.Decimal(14, 2)
  changeGiven  Decimal?   @db.Decimal(14, 2)
  // Existing rows default to ACCEPTED on migration — every sale created before this column
  // existed is, by definition, an already-completed transaction (stock was always deducted
  // immediately). Only NEW rows created by a seller's "Отправить заказ" start as PENDING.
  status       SaleStatus @default(ACCEPTED)
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())
  // Owner-panel cancellation of an already-ACCEPTED sale (see owner.service.ts's cancelSale) —
  // never a DELETE, just this terminal-status flip plus a SaleChangeLog(SALE_CANCELLED) row.
  // totalAmount/items are left exactly as they were at cancellation time so the owner can always
  // see what the sale WAS; report queries simply stop counting it once status !== ACCEPTED.
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  items      SaleItem[]
  changeLogs SaleChangeLog[]

  @@index([createdAt])
  @@index([sellerId])
  // Reports (Module 7) always scope by location first, then filter/range on createdAt —
  // a composite index serves that access pattern directly instead of intersecting two scans.
  @@index([locationId, createdAt])
  // The admin "pending orders" queue filters by locationId + status=PENDING, oldest first.
  @@index([locationId, status])
  @@index([tableId])
  @@map("sales")
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @db.Decimal(12, 2) // цена "заморожена" на момент продажи
  subtotal  Decimal        @db.Decimal(14, 2)
  // Owner-panel soft removal (see owner.service.ts's removeSaleItem) — the row is NEVER deleted,
  // just flagged, so the original sale composition stays fully reconstructable; every read that
  // computes an active total/quantity filters `removedAt: null`. A row added by the owner after
  // the fact (owner.service.ts's addSaleItem) is a normal new SaleItem, distinguished only by a
  // SaleChangeLog(ITEM_ADDED) entry referencing it — no separate flag needed for "added".
  removedAt    DateTime?
  removedById  String?
  removedBy    User?     @relation("SaleItemRemovedBy", fields: [removedById], references: [id])
  removeReason String?

  @@index([saleId])
  // Top-products report groups by variantId across a (potentially large) date-filtered set.
  @@index([variantId])
  @@map("sale_items")
}

// Permanent, append-only correction log — the owner panel's entire reason for existing instead
// of allowing edits/deletes elsewhere. One row per single field/item change (see
// owner.service.ts), never updated or deleted by any code path in the app.
model SaleChangeLog {
  id         String         @id @default(cuid())
  saleId     String
  sale       Sale           @relation(fields: [saleId], references: [id])
  // Set for an item-level change (removed/added/quantity/price), null for a sale-level one
  // (cancelled) — nullable rather than a required FK since the target isn't always one row.
  saleItemId String?
  changeType SaleChangeType
  // Precomputed human-readable summary (e.g. "Кола ×1 удалена", "Лаваш: количество 2 → 1") so
  // the owner panel's history list is a simple string render, not a per-changeType switch in the
  // UI — see owner.service.ts for how each mutation builds this.
  description   String
  oldValue      String?
  newValue      String?
  reason        String?
  performedById String
  performedBy   User     @relation("SaleChangePerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime @default(now())

  @@index([saleId, performedAt])
  @@map("sale_change_logs")
}

// Журнал движения склада — единственный путь изменения остатков (аудит).
model StockMovement {
  id             String      @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient  @relation(fields: [ingredientId], references: [id])
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id])
  change         Decimal     @db.Decimal(12, 3) // + приход / - расход
  // Остаток непосредственно до/после этой операции — для истории пополнений (null у записей,
  // созданных до добавления этих колонок).
  quantityBefore Decimal?    @db.Decimal(12, 3)
  quantityAfter  Decimal?    @db.Decimal(12, 3)
  reason         StockReason
  note           String? // комментарий к ручному пополнению/списанию
  referenceId    String? // id продажи / закупки
  createdById    String
  createdBy      User        @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([ingredientId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ── Future-ready (defined now, implemented later) ────────────

model PriceHistory {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  oldPrice    Decimal        @db.Decimal(12, 2)
  newPrice    Decimal        @db.Decimal(12, 2)
  changedById String
  changedBy   User           @relation("PriceChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime       @default(now())

  @@index([variantId])
  @@map("price_history")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique // cafe_name, logo_url, currency, contact_phone…
  value String

  @@map("settings")
}

model Backup {
  id          String   @id @default(cuid())
  filename    String
  size        Int      @default(0)
  createdById String
  createdBy   User     @relation("BackupCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("backups")
}

// ── AI Assistant ─────────────────────────────────────────────

// USER — sent by the owner/admin; ASSISTANT — the AI's reply (local rule-based
// provider today, swappable for OpenAI/Claude later — see modules/ai/providers).
enum AiMessageRole {
  USER
  ASSISTANT
}

model AiMessage {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("AiMessageOwner", fields: [userId], references: [id])
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  role       AiMessageRole
  content    String
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("ai_messages")
}
